# Strict Anti-Execution Lockdown for Ephemeral Image Cache
# Prevents any PHP, CGI, Perl, ASP script execution even if a polyglot file is present

# 1. Disable PHP engine
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 2. Neutralize all script handlers and force static plain-file serving
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .asp .aspx .sh .bash .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .asp .aspx .sh .bash .py
SetHandler default-handler

# 3. Prevent MIME-sniffing attacks & Allow Cross-Origin Image Fetch & Direct Download
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header set Access-Control-Allow-Headers "*"
    Header set Access-Control-Expose-Headers "Content-Length, Content-Type, Content-Disposition"
</IfModule>

# 4. Disable Directory Browsing and Script Execution
Options -Indexes -ExecCGI

